<style>
/* ── Base ── */
.learning-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem 4rem; }
.learning-header { text-align: center; margin-bottom: 2rem; }
.learning-header h1 { font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
.learning-header p { color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem; }
