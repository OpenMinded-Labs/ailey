/**
 * A!ley Portal — Learning Hub (PHP-native)
 *
 * All curricula data, quiz evaluation, progress tracking — direct PHP/MySQL.
 * Only "Frag Ailey" (LLM lessons) goes through the poller to Python backend.
 * Requires login + admin-granted access.
 */
require_once __DIR__ . '/layout.php';
if (!$user) { header('Location: /login'); exit; }

portal_head('Learning');
$userId = $user['id'];
$userName = htmlspecialchars($user['display_name'] ?? 'User');
