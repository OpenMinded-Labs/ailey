# ═══════════════════════════════════════════════════════════════
# Ailey — Example environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ═══════════════════════════════════════════════════════════════

# ── Access control ────────────────────────────────────────────
AILEY_MASTER_PASSWORD=changeme          # unlocks private "thoughts" session
AILEY_GALLERY_PIN=0000                   # PIN for the hidden gallery

# ── Email agent (IMAP/SMTP) ───────────────────────────────────
AILEY_MAIL_USER=your_mail_user
AILEY_MAIL_PASSWORD=your_mail_password
AILEY_MAIL_IMAP_HOST=mail.example.com
AILEY_MAIL_SMTP_HOST=mail.example.com

# ── Portal connection ─────────────────────────────────────────
AILEY_PORTAL_URL=https://your-portal.example.com
AILEY_PORTAL_KEY=your_shared_portal_key

# ── Hugging Face (model download / upload) ────────────────────
HF_TOKEN=hf_your_token_here
